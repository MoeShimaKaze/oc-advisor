{
  "name": "oc-advisor",
  "version": "0.2.0",
  "description": "OpenCode plugin that lets a fast executor model consult a smarter advisor model for strategic advice when stuck.",
  "license": "MIT",
  "author": "yuk1ty <yuk1ty@users.noreply.github.com>",
  "homepage": "https://github.com/yuk1ty/oc-advisor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuk1ty/oc-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/yuk1ty/oc-advisor/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "advisor",
    "llm",
    "agent",
    "ai"
  ],
  "type": "module",
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun run build:plugin",
    "build:plugin": "bun build .opencode/plugins/advisor.ts --target=bun --external @opencode/plugin --outfile dist/plugin.js",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24"
  }
}